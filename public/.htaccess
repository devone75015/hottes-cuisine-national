# =============================================================================
#  Configuration Apache — hébergement mutualisé Hostinger
#  Ce fichier est copié tel quel dans out/ puis dans public_html/
# =============================================================================

# ---------------------------------------------------------------------------
#  Page 404
#  Next produit out/404.html lors de l'export statique.
# ---------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
#  Protection des fichiers de travail
#  leads.log contient des coordonnées de prospects : il ne doit jamais être
#  servi. Idem pour tout fichier de sauvegarde laissé par mégarde.
# ---------------------------------------------------------------------------
<FilesMatch "\.(log|bak|sql|env|json~)$">
  Require all denied
</FilesMatch>

<Files "leads.log">
  Require all denied
</Files>

# ---------------------------------------------------------------------------
#  En-têtes de sécurité
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Les fichiers versionnés par Next portent un hash dans leur nom :
  # ils peuvent être mis en cache indéfiniment sans risque.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Le HTML, lui, doit être revalidé : c'est ce qui permet à une mise à jour
  # de contenu d'être visible sans attendre l'expiration d'un cache.
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---------------------------------------------------------------------------
#  Compression
# ---------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------------------------------------------------------------------------
#  Canonicalisation des URL
#
#  Le site est construit avec trailingSlash: true — chaque page vit dans
#  out/<chemin>/index.html. Sans ces règles, /nettoyage-hotte-restaurant
#  et /nettoyage-hotte-restaurant/ seraient deux URL distinctes servant le
#  même contenu : du duplicate créé par la configuration serveur, après tout
#  le travail fait pour l'éviter dans le contenu.
#
#  ⚠ La variante SANS www est active, cohérente avec lib/site.ts. Pour servir
#    le site sur www, inversez : activez la variante A, désactivez la B, et
#    changez NEXT_PUBLIC_SITE_URL en conséquence.
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # -- Forcer HTTPS ---------------------------------------------------------
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # -- Variante A : tout vers www (décommentez si vous retenez le www) ------
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [R=301,L]

  # -- Variante B : tout sans www — ACTIVE, cohérente avec lib/site.ts ------
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # -- Ajouter le slash final sur les répertoires ---------------------------
  # /page  ->  /page/   pour que la canonique soit toujours atteinte.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>
