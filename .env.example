# =============================================================================
#  Variables d'environnement — à renseigner dans hPanel
#  Hostinger : Sites web > votre app Node > Variables d'environnement
# =============================================================================

# OBLIGATOIRE. Domaine réel du site, sans slash final.
#
# Cette valeur alimente les balises canonical, les og:image, le sitemap.xml et
# le robots.txt. Si elle n'est pas renseignée, le site se déclare lui-même sur
# le domaine de démonstration : Google indexerait des URL canoniques fausses,
# ce qui est le pire scénario SEO possible.
NEXT_PUBLIC_SITE_URL=https://reparationhottecuisinenettoyage.fr

# Mesure — les deux balises sont posées dans le <head> au moment du build.
# Les laisser vides (et non commentées) désactive la balise : c'est ce qu'il faut
# faire sur un environnement de préproduction, pour ne pas polluer les
# statistiques de production avec du trafic de test.

# Conteneur Google Tag Manager.
# NEXT_PUBLIC_GTM_ID=GTM-MBDMJ6C3

# Tag Google Ads (gtag.js), en coexistence avec GTM sur le même dataLayer.
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18208756397

# Renseigné automatiquement par Hostinger — ne pas définir à la main.
# PORT=3000
# HOSTNAME=0.0.0.0
